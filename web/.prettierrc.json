{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": false,
  "printWidth": 80,
  "tabWidth": 4,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "overrides": [
    {
      "comment": "npm reescribe package.json a dos espacios en cada install: pelearse con él no lleva a ninguna parte.",
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2 }
    }
  ]
}
