[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl}]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 80

# Los ficheros de configuración de la raíz sí van a dos espacios: es como los
# escriben npm y las herramientas que los reescriben solas.
[*.{json,yml,yaml}]
indent_size = 2
